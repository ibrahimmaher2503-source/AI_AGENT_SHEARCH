# AI Radar — environment variables
# Copy to `.env` and fill in real values:  cp .env.example .env

# --- API keys ---
GEMINI_API_KEY=
NOTION_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# --- Notion parent page (where setup_notion.py creates the 9 DBs) ---
NOTION_PARENT_PAGE_ID=

# --- Notion database IDs (printed by `python setup_notion.py`) ---
NOTION_DB_MODELS=
NOTION_DB_TOOLS=
NOTION_DB_RESEARCH=
NOTION_DB_SIGNALS=
NOTION_DB_OPPORTUNITIES=
NOTION_DB_BRIEFS=
NOTION_DB_OSS_RADAR=
NOTION_DB_HF_RADAR=
NOTION_DB_ALERTS=

# --- Pipeline ---
# Set to "true" to skip Notion writes (prints payloads instead)
DRY_RUN=false
